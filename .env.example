# Server-side only. Consumed by the /api/translate-notice serverless function
# via process.env.OPENAI_API_KEY. Do NOT prefix with VITE_ — a VITE_ prefix
# inlines the value into the public client bundle.
OPENAI_API_KEY="your_openai_api_key_here"

# Optional. Server-side only, same rule — no VITE_ prefix. When set, and the
# request carries devmode:true (from ?devmode=verify), /api/translate-notice
# falls back to OpenRouter if the OpenAI call fails. Leave unset to disable.
OPENROUTER_API_KEY=""
